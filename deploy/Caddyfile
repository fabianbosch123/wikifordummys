# Caddy holt das TLS-Zertifikat für die Domain automatisch bei Let's Encrypt
{$WIKI_DOMAIN} {
	encode zstd gzip

	header {
		# S11: Security-Header
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		# Weboberfläche und API setzen eine eigene, strengere CSP (Weboberfläche mit Nonce je Anfrage, S6);
		# diese gilt nur, wenn eine Antwort keine eigene mitbringt
		?Content-Security-Policy "default-src 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# Uploads von Anhängen dürfen groß sein (ATTACHMENT_MAX_MB, Standard 50 MiB; die API prüft die genaue Grenze),
	# alle anderen Anfragen bleiben klein. Die beiden Matcher schließen sich aus.
	@upload path_regexp ^/api/v1/pages/[^/]+/attachments$
	@notUpload not path_regexp ^/api/v1/pages/[^/]+/attachments$
	request_body @upload {
		max_size 51MiB
	}
	request_body @notUpload {
		max_size 2MB
	}

	handle /api/* {
		reverse_proxy api:3001
	}

	handle {
		reverse_proxy web:3000
	}

	log {
		output stdout
		format json
	}
}
