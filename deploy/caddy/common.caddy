# Gemeinsamer Teil aller Betriebsarten, eingebunden aus <betriebsart>.Caddyfile.
# Die Betriebsart (WIKI_TLS in .env) legt nur fest, woher das TLS-Zertifikat kommt.

encode zstd gzip

header {
	# S11: Security-Header
	Strict-Transport-Security "max-age=31536000; includeSubDomains"
	X-Content-Type-Options "nosniff"
	Referrer-Policy "strict-origin-when-cross-origin"
	Permissions-Policy "camera=(), microphone=(), geolocation=()"
	-Server
}

# Das Wiki selbst darf nirgends eingebettet werden
@wiki not path /office/* /draw/*
header @wiki {
	X-Frame-Options "DENY"
	# Weboberfläche und API setzen eine eigene, strengere CSP (Weboberfläche mit Nonce je Anfrage, S6);
	# diese gilt nur, wenn eine Antwort keine eigene mitbringt
	?Content-Security-Policy "default-src 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'"
}

# Der Office-Editor läuft als Rahmen in den Seiten des Wikis, aber nur dort
header /office/* {
	X-Frame-Options "SAMEORIGIN"
	?Content-Security-Policy "frame-ancestors 'self'; object-src 'none'; base-uri 'self'"
}

# draw.io (Dienst drawio, optional) läuft als Rahmen im Seiteneditor, abgeschottet vom Wiki: sandbox ohne
# allow-same-origin gibt ihm einen eigenen, leeren Ursprung, also keinen Zugriff auf Cookies, Speicher und API.
# Verbindungen nur zum eigenen Server (keine externen Dienste), Austausch mit dem Wiki nur per postMessage.
# Die Dateien lädt draw.io dann von „fremdem“ Ursprung; sie sind öffentlich (Open Source), daher Access-Control-Allow-Origin *.
header /draw/* {
	X-Frame-Options "SAMEORIGIN"
	Content-Security-Policy "sandbox allow-scripts allow-downloads allow-popups allow-modals; default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' data: blob:; worker-src 'self' blob:; frame-src 'self' blob: data:; media-src 'self' data: blob:; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'self'"
	Access-Control-Allow-Origin "*"
	Cross-Origin-Resource-Policy "cross-origin"
}

# Uploads von Anhängen und neuen Fassungen dürfen groß sein (ATTACHMENT_MAX_MB, Standard 50 MiB; die API prüft die
# genaue Grenze), ebenso Bilder, die im Office-Editor in Dokumente eingefügt werden; alle anderen Anfragen bleiben klein.
@upload path_regexp ^/api/v1/(pages/[^/]+/attachments|attachments/[^/]+/versions)$
@small {
	not path_regexp ^/api/v1/(pages/[^/]+/attachments|attachments/[^/]+/versions)$
	not path /office/*
}
request_body @upload {
	max_size {$ATTACHMENT_MAX_MB:50}MiB
}
request_body /office/* {
	max_size {$ATTACHMENT_MAX_MB:50}MiB
}
request_body @small {
	max_size 2MB
}

# Nur der Editor-Server ruft diese API-Pfade auf, und zwar im internen Docker-Netz direkt bei der API
@officeInternal path /api/v1/office/files/* /api/v1/office/callback
handle @officeInternal {
	respond 404
}

handle /api/* {
	reverse_proxy api:3001
}

# Office-Editor (Dienst office, optional): Beispiel-App, Infoseite und Verwaltung des Editor-Servers bleiben gesperrt
@officeBlocked path /office/example* /office/info* /office/admin*
handle @officeBlocked {
	respond 404
}

handle_path /office/* {
	reverse_proxy office:80 {
		# Der Editor erzeugt seine Adressen aus Host und Präfix; nach außen ist das Wiki immer https
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Prefix /office
		header_up X-Forwarded-Proto https
	}
}

# draw.io (Dienst drawio, optional): nur statische Dateien, Lesen genügt
redir /draw /draw/
@drawioWrite {
	path /draw/*
	not method GET HEAD
}
handle @drawioWrite {
	respond 405
}
handle /draw/* {
	reverse_proxy drawio:8080
}

handle {
	reverse_proxy web:3000
}

log {
	output stdout
	format json
}
