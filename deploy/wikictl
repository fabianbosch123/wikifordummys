#!/usr/bin/env bash
# wikictl: Betrieb von wikifordummys (Status, Update, Sicherung, Wiederherstellung, Umzug, Überwachung).
# Wird von install.sh nach /usr/local/bin/wikictl verlinkt.
set -Eeuo pipefail

# shellcheck source=deploy/lib.sh
source "$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)/lib.sh"

STAGING=${WIKI_BACKUP_STAGING:-/var/lib/wikifordummys-backup}
RETENTION=(--keep-daily 7 --keep-weekly 4 --keep-monthly 6)

usage() {
  cat <<'EOF'
Verwendung: sudo wikictl <befehl> [optionen]

Betrieb
  status                  Zustand der Dienste, Health-Check, Zertifikat, letzte Sicherung
  logs [dienst]           Logs verfolgen (caddy, web, api, db, redis, office, drawio)
  start | stop | restart  Dienste starten, anhalten, neu starten
  update [git-ref]        Sicherung, neuen Stand holen (Standard: aktueller Branch), bauen, neu starten
  reconfigure             Installer erneut ausführen (Domain, SMTP, Sicherung … ändern)
  cleanup                 Platz schaffen: Docker-Build-Cache, unbenutzte Images, Systemjournal
                          (Datenbank, Anhänge und Sicherungen bleiben unberührt)

Benutzer und Mail
  create-admin --email <adresse> --name "<name>" [--invite]
                          weiteren Administrator anlegen; zeigt ein Startpasswort an
                          (mit --invite stattdessen Einladungslink per Mail)
  reset-password --email <adresse>                 neues Startpasswort setzen und anzeigen
                          (z. B. wenn der Mailversand nicht funktioniert)
  mail-test [--to <adresse>]                        Mailversand prüfen

Office-Editor (WIKI_OFFICE in .env)
  office on | off         Office-Editor einrichten bzw. abschalten (das Update fragt einmal danach)
  office-check            Editor-Server, JWT-Geheimnis und Dateiaustausch prüfen

Zeichnungen (WIKI_DRAWIO in .env)
  drawio on | off         draw.io für Zeichnungen auf Seiten einrichten bzw. abschalten
                          (vorhandene Zeichnungen bleiben als Bild sichtbar)

Sicherung (restic, Ziel aus .env)
  backup                  jetzt sichern (Datenbank, Anhänge, Zertifikate, .env), alte Stände ausdünnen
  snapshots               vorhandene Sicherungen auflisten
  restore <id|latest> [--with-env] [--yes]
                          Stand zurückspielen; --with-env übernimmt auch .env (neuer Server)
  restore-test            Sicherung probeweise in einen Wegwerf-Container einspielen und prüfen
  backup-init             Sicherungsziel anlegen bzw. prüfen

Umzug auf einen anderen Server (docs/umzug.md)
  export [--output <datei>] [--passphrase-file <datei>] [--stop]
                          alles in eine verschlüsselte Datei packen (Wiki dabei kurz angehalten);
                          --stop lässt den alten Server danach aus
  import <datei> [--passphrase-file <datei>] [--yes]
                          Umzugsdatei auf einem frisch installierten Server einspielen und prüfen

Sonstiges
  ca-cert                 Stammzertifikat der internen Zertifizierungsstelle ausgeben (Betriebsart internal)
  monitor                 Health-Check für den systemd-Timer; ruft MONITOR_PING_URL auf, wenn alles läuft
EOF
}

need_root() {
  [[ $(id -u) -eq 0 ]] || die "Bitte mit sudo ausführen."
}

need_env() {
  [[ -f $ENV_FILE ]] || die "$ENV_FILE fehlt. Zuerst installieren: sudo $WIKI_DIR/install.sh"
}

volume_path() {
  docker volume inspect -f '{{ .Mountpoint }}' "${COMPOSE_PROJECT}_$1" 2>/dev/null
}

# ---------------------------------------------------------------------------

cmd_status() {
  need_env
  local domain tls
  domain=$(env_get WIKI_DOMAIN)
  tls=$(env_get WIKI_TLS)
  step "Dienste"
  compose ps --format 'table {{.Service}}\t{{.State}}\t{{.Status}}'
  step "Health-Check"
  compose exec -T api node -e "fetch('http://127.0.0.1:3001/api/v1/health').then(r=>r.text()).then(t=>console.log(t),e=>{console.log('nicht erreichbar: '+e.message);process.exit(1)})" ||
    warn "API antwortet nicht."
  if [[ $(env_get WIKI_OFFICE) == true ]]; then
    step "Office-Editor"
    # Ergebnis der Gesundheitsprüfung aus docker-compose.yml, bei Fehlern mit der letzten Ausgabe
    local id health=''
    id=$(compose ps -q office 2>/dev/null || true)
    if [[ -n $id ]]; then
      health=$(docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{end}}' "$id" 2>/dev/null || true)
    fi
    case $health in
      healthy) ok "Office-Editor bereit." ;;
      starting) warn "Office-Editor startet noch (beim ersten Start einige Minuten)." ;;
      *)
        warn "Office-Editor antwortet nicht (${health:-läuft nicht}; wikictl logs office)."
        if [[ -n $id ]]; then
          docker inspect -f '{{if .State.Health}}{{range .State.Health.Log}}{{.ExitCode}}: {{.Output}}{{end}}{{end}}' "$id" 2>/dev/null | tail -n 3 || true
        fi
        ;;
    esac
  fi
  if [[ $(env_get WIKI_DRAWIO) == true ]]; then
    step "draw.io"
    local drawio_id drawio_health=''
    drawio_id=$(compose ps -q drawio 2>/dev/null || true)
    if [[ -n $drawio_id ]]; then
      drawio_health=$(docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{end}}' "$drawio_id" 2>/dev/null || true)
    fi
    if [[ $drawio_health == healthy ]]; then ok "draw.io bereit."; else warn "draw.io antwortet nicht (${drawio_health:-läuft nicht}; wikictl logs drawio)."; fi
  fi
  if [[ ${tls:-letsencrypt} != proxy ]]; then
    step "Zertifikat"
    local end
    end=$(echo | timeout 10 openssl s_client -connect 127.0.0.1:443 -servername "$domain" 2>/dev/null | openssl x509 -noout -enddate -issuer 2>/dev/null || true)
    if [[ -n $end ]]; then info "$end"; else warn "Kein Zertifikat abrufbar."; fi
  fi
  step "Speicherplatz"
  df -h / "$(docker info -f '{{.DockerRootDir}}' 2>/dev/null || echo /var/lib/docker)" | awk '!seen[$0]++'
  if (($(docker_free_mb) < 3000)); then warn "Weniger als 3 GB frei. Platz schaffen mit: sudo wikictl cleanup"; fi
  step "Sicherung"
  if restic_env; then
    restic snapshots --latest 1 --compact 2>/dev/null || warn "Sicherungsziel nicht erreichbar."
    systemctl list-timers 'wikifordummys-*' --no-pager 2>/dev/null || true
  else
    warn "Keine Sicherung eingerichtet (sudo ./install.sh oder BACKUP_* in .env)."
  fi
  info "Version: $(git -C "$WIKI_DIR" describe --always --tags 2>/dev/null || echo unbekannt)"
}

cmd_logs() {
  need_env
  compose logs -f --tail 100 "$@"
}

cmd_update() {
  need_root
  need_env
  local ref=${1:-}
  check_space_for_update
  step "Sicherung vor dem Update"
  if restic_env; then
    cmd_backup
  else
    install -d -m 700 /var/backups/wikifordummys
    local file
    file=/var/backups/wikifordummys/vor-update-$(date +%F-%H%M).sql.gz
    compose exec -T db pg_dump -U wiki wiki | gzip >"$file"
    chmod 600 "$file"
    ok "Datenbank gesichert nach $file (Anhänge nicht; besser restic einrichten)."
    # Nur die letzten fünf Sicherungen vor Updates behalten, sonst füllt jedes Update die Platte weiter
    find /var/backups/wikifordummys -maxdepth 1 -name 'vor-update-*.sql.gz' -printf '%T@ %p\n' |
      sort -rn | tail -n +6 | cut -d' ' -f2- | xargs -r -d '\n' rm -f --
  fi
  step "Neuen Stand holen"
  local before
  before=$(git -C "$WIKI_DIR" rev-parse --short HEAD)
  git -C "$WIKI_DIR" fetch --tags --quiet
  if [[ -n $ref ]]; then
    git -C "$WIKI_DIR" checkout --quiet "$ref"
  fi
  if git -C "$WIKI_DIR" symbolic-ref -q HEAD >/dev/null; then
    git -C "$WIKI_DIR" pull --ff-only --quiet
  fi
  info "Stand: $before → $(git -C "$WIKI_DIR" rev-parse --short HEAD)"
  # Ab hier mit dem neuen Stand von wikictl weitermachen, damit neue Schritte schon bei diesem Update greifen
  exec "$WIKI_DIR/deploy/wikictl" update-apply "$before"
}

# Zweiter Teil des Updates, läuft bereits mit dem neuen Stand des Skripts
cmd_update_apply() {
  need_root
  need_env
  local before=${1:-}
  if [[ -z $(env_get WIKI_OFFICE) ]]; then offer_office; fi
  if [[ -z $(env_get WIKI_DRAWIO) ]]; then offer_drawio; fi
  ipv6_setup
  step "Bauen und neu starten"
  # Images ohne eigenen Bau (Caddy, Datenbank, Redis, Office) zieht compose up nur, wenn sie fehlen
  compose pull --ignore-buildable --quiet
  compose build --pull
  if [[ $(env_get WIKI_OFFICE) != true ]]; then
    compose --profile office rm -sf office >/dev/null 2>&1 || true
  fi
  if [[ $(env_get WIKI_DRAWIO) != true ]]; then
    compose --profile drawio rm -sf drawio >/dev/null 2>&1 || true
  fi
  compose up -d --remove-orphans
  reload_caddy
  if wait_healthy 300; then
    wait_drawio
    wait_office
    ok "Update abgeschlossen."
  else
    compose logs --tail 40 api
    die "Die API ist nach dem Update nicht gesund. Zurück zum alten Stand: sudo wikictl update $before (Datenbank ggf. mit wikictl restore)."
  fi
  # Jeder Bau hinterlässt Build-Cache und alte Image-Stände; ohne Aufräumen läuft die Platte mit der Zeit voll
  docker_cleanup
  if systemctl is-active --quiet fail2ban 2>/dev/null; then
    # Neue Container schreiben in neue Logdateien; fail2ban liest die Dateiliste nur beim Laden
    fail2ban-client reload wikifordummys >/dev/null 2>&1 || true
  fi
}

# Bauen und Image-Download brauchen mehrere GB. Läuft die Platte dabei voll, startet die Datenbank
# nicht mehr ("No space left on device"). Deshalb vorher prüfen, erst aufräumen, notfalls abbrechen.
check_space_for_update() {
  local need=4000 free
  if [[ $(env_get WIKI_OFFICE) == true ]]; then need=6000; fi
  free=$(docker_free_mb)
  ((free >= need)) && return 0
  step "Speicherplatz"
  info "Nur $((free / 1024)) GB frei; räume Docker-Build-Cache und alte Images auf …"
  docker_cleanup all
  free=$(docker_free_mb)
  if ((free < need)); then
    die "Nur $((free / 1024)) GB frei, das Update braucht etwa $((need / 1000)) GB. Platz schaffen (sudo wikictl cleanup; Übersicht mit df -h und sudo du -sh /var/lib/docker/* /var/log /var/backups) und erneut starten."
  fi
  ok "$((free / 1024)) GB frei."
}

cmd_cleanup() {
  need_root
  need_env
  local before after
  before=$(docker_free_mb)
  step "Docker aufräumen (Build-Cache, unbenutzte Images; Volumes bleiben)"
  docker_cleanup all
  # Entfernt Images, die kein Container mehr nutzt (z. B. der abgeschaltete Office-Editor); laufende Dienste behalten ihre
  docker image prune -af >/dev/null 2>&1 || true
  step "Systemjournal auf 200 MB begrenzen, Paket-Cache leeren"
  journalctl --vacuum-size=200M >/dev/null 2>&1 || true
  apt-get clean >/dev/null 2>&1 || true
  after=$(docker_free_mb)
  ok "Frei: $((before / 1024)) GB → $((after / 1024)) GB"
  if [[ -d /var/backups/wikifordummys ]]; then
    info "Datenbank-Sicherungen vor Updates: $(du -sh /var/backups/wikifordummys | cut -f1) in /var/backups/wikifordummys (ältere lassen sich löschen)."
  fi
  # Bei voller Platte hängen Datenbank und API in der Neustart-Schleife; jetzt wieder starten
  compose up -d >/dev/null 2>&1 || true
}

# Neu seit dem Update: Office-Editor anbieten (nur einmal; die Antwort landet in .env)
offer_office() {
  step "Neu: Office-Editor"
  info "Word-, Excel- und PowerPoint-Anhänge lassen sich jetzt mit Euro-Office im Wiki ansehen und gemeinsam"
  info "bearbeiten (zusätzlicher Dienst, etwa 4 GB Arbeitsspeicher mehr; 8 GB empfohlen)."
  local default=j answer
  if ! office_mem_ok; then
    warn "Dieser Server hat $(mem_gb) GB Arbeitsspeicher."
    default=n
  fi
  if [[ -t 0 ]]; then
    read -r -p "Office-Editor jetzt einrichten? $([[ $default == j ]] && echo '[J/n]' || echo '[j/N]'): " answer || answer=''
    answer=${answer:-$default}
  else
    answer=n
  fi
  case ${answer,,} in
    j | ja | y | yes)
      office_set true
      ok "Office-Editor wird mit diesem Update eingerichtet."
      ;;
    *)
      office_set false
      info "Office-Editor bleibt aus. Später einschalten mit: sudo wikictl office on"
      ;;
  esac
}

# Office-Editor an- oder abschalten, ohne den ganzen Installer
cmd_office() {
  need_root
  need_env
  case ${1:-} in
    on)
      if ! office_mem_ok; then warn "Dieser Server hat $(mem_gb) GB Arbeitsspeicher; für Wiki und Editor sind 8 GB empfohlen."; fi
      office_set true
      compose up -d --remove-orphans
      reload_caddy
      wait_office
      compose exec -T api node dist/cli.js office-check || warn "Prüfung fehlgeschlagen; erneut mit: sudo wikictl office-check"
      ;;
    off)
      office_set false
      compose --profile office rm -sf office >/dev/null 2>&1 || true
      compose up -d --remove-orphans
      ok "Office-Editor abgeschaltet. Anhänge bleiben unverändert erhalten."
      ;;
    *)
      echo "Verwendung: sudo wikictl office on|off" >&2
      exit 2
      ;;
  esac
}

# Neu seit dem Update: draw.io anbieten (nur einmal; die Antwort landet in .env). Klein und ohne externe Dienste,
# daher ohne Rückfrage (z. B. bei Updates per Skript) eingeschaltet.
offer_drawio() {
  step "Neu: Zeichnungen mit draw.io"
  info "Auf Seiten lassen sich jetzt Zeichnungen wie Netzwerkpläne mit draw.io anlegen und bearbeiten"
  info "(kleiner zusätzlicher Dienst: nur statische Dateien, etwa 150 MB Platz, kaum Arbeitsspeicher)."
  local answer=j
  if [[ -t 0 ]]; then
    read -r -p "draw.io jetzt einrichten? [J/n]: " answer || answer=''
    answer=${answer:-j}
  fi
  case ${answer,,} in
    j | ja | y | yes)
      env_set WIKI_DRAWIO true
      ok "draw.io wird mit diesem Update eingerichtet. Abschalten mit: sudo wikictl drawio off"
      ;;
    *)
      env_set WIKI_DRAWIO false
      info "draw.io bleibt aus. Später einschalten mit: sudo wikictl drawio on"
      ;;
  esac
}

# draw.io an- oder abschalten, ohne den ganzen Installer
cmd_drawio() {
  need_root
  need_env
  case ${1:-} in
    on)
      env_set WIKI_DRAWIO true
      compose build drawio
      compose up -d --remove-orphans
      reload_caddy
      wait_drawio
      ;;
    off)
      env_set WIKI_DRAWIO false
      compose --profile drawio rm -sf drawio >/dev/null 2>&1 || true
      compose up -d --remove-orphans
      ok "draw.io abgeschaltet. Vorhandene Zeichnungen bleiben als Bild auf den Seiten sichtbar."
      ;;
    *)
      echo "Verwendung: sudo wikictl drawio on|off" >&2
      exit 2
      ;;
  esac
}

cmd_backup_init() {
  need_root
  need_env
  restic_env || die "Kein Sicherungsziel in .env (BACKUP_REPOSITORY, BACKUP_PASSWORD)."
  command -v restic >/dev/null || die "restic fehlt: sudo apt install restic"
  if [[ $RESTIC_REPOSITORY == /* ]]; then
    install -d -m 700 "$RESTIC_REPOSITORY"
  fi
  if restic cat config >/dev/null 2>&1; then
    ok "Sicherungsziel $RESTIC_REPOSITORY ist bereit."
  else
    restic init >/dev/null
    ok "Sicherungsziel $RESTIC_REPOSITORY angelegt."
  fi
}

cmd_backup() {
  need_root
  need_env
  restic_env || die "Kein Sicherungsziel in .env (BACKUP_REPOSITORY, BACKUP_PASSWORD). Einrichten mit: sudo ./install.sh"
  local ping
  ping=$(env_get BACKUP_PING_URL)
  if ! backup_run; then
    if [[ -n $ping ]]; then ping_url "$ping/fail"; fi
    die "Sicherung fehlgeschlagen."
  fi
  if [[ -n $ping ]]; then ping_url "$ping"; fi
  return 0
}

# backup_run [vor-wiederherstellung]: mit Argument ein eigener Stand, der beim Ausdünnen nicht mitzählt
backup_run() {
  local tag=${1:-wikifordummys}
  (
    set -Eeuo pipefail
    install -d -m 700 "$STAGING"
    step "Datenbank exportieren"
    # Unkomprimiertes SQL, damit restic zwischen den Ständen deduplizieren kann
    compose exec -T db pg_dump -U wiki --clean --if-exists --no-owner wiki >"$STAGING/wiki.sql.tmp"
    mv "$STAGING/wiki.sql.tmp" "$STAGING/wiki.sql"
    cp -p "$ENV_FILE" "$STAGING/env"
    git -C "$WIKI_DIR" rev-parse HEAD >"$STAGING/version" 2>/dev/null || true
    local attachments caddy
    attachments=$(volume_path attachments) || die "Volume ${COMPOSE_PROJECT}_attachments fehlt."
    caddy=$(volume_path caddy_data) || caddy=''
    step "Sichern nach $RESTIC_REPOSITORY"
    local paths=("$STAGING" "$attachments")
    if [[ -n $caddy ]]; then paths+=("$caddy"); fi
    restic backup --tag "$tag" --host "$(hostname)" "${paths[@]}"
    if [[ $tag == wikifordummys ]]; then
      step "Alte Stände ausdünnen (7 täglich, 4 wöchentlich, 6 monatlich)"
      restic forget --tag wikifordummys "${RETENTION[@]}" --prune --quiet
    fi
    rm -f "$STAGING/wiki.sql"
    ok "Sicherung abgeschlossen."
  )
}

cmd_snapshots() {
  need_root
  need_env
  restic_env || die "Kein Sicherungsziel eingerichtet."
  restic snapshots
}

# Holt einen Stand in ein temporäres Verzeichnis; Ausgabe: Verzeichnis mit staging/, attachments/, caddy_data/
restore_to_dir() {
  local id=$1 target=$2 attachments caddy src
  if [[ $id == latest ]]; then
    id=$(restic snapshots --tag wikifordummys --latest 1 --json | grep -o '"short_id":"[^"]*"' | tail -1 | cut -d'"' -f4)
    [[ -n $id ]] || die "Es gibt noch keine Sicherung."
    info "Neuester Stand: $id"
  fi
  restic restore "$id" --target "$target/raw" >/dev/null
  install -d "$target/staging" "$target/attachments" "$target/caddy_data"
  # In der Sicherung stehen die Originalpfade; die Volumes können auf einem neuen Server woanders liegen
  src=$(restic ls "$id" --json 2>/dev/null | grep -o '"path":"[^"]*_attachments/_data"' | head -1 | cut -d'"' -f4) || true
  attachments=${src:-}
  src=$(restic ls "$id" --json 2>/dev/null | grep -o '"path":"[^"]*_caddy_data/_data"' | head -1 | cut -d'"' -f4) || true
  caddy=${src:-}
  local staging_src
  staging_src=$(restic ls "$id" --json 2>/dev/null | grep -o '"path":"[^"]*/wiki.sql"' | head -1 | cut -d'"' -f4) || true
  [[ -n $staging_src ]] || die "In der Sicherung $id fehlt der Datenbankexport."
  cp -a "$target/raw$(dirname "$staging_src")/." "$target/staging/"
  if [[ -n $attachments && -d $target/raw$attachments ]]; then cp -a "$target/raw$attachments/." "$target/attachments/"; fi
  if [[ -n $caddy && -d $target/raw$caddy ]]; then cp -a "$target/raw$caddy/." "$target/caddy_data/"; fi
  rm -rf "$target/raw"
}

# Spielt einen ausgepackten Stand ein (Verzeichnis mit staging/wiki.sql, attachments/, caddy_data/): Datenbank frisch
# anlegen, Anhänge und (falls vorhanden) Zertifikate ersetzen, Sitzungen verwerfen, starten. Gemeinsam für restore und import.
restore_apply() {
  local tmp=$1
  step "Dienste anhalten"
  compose stop caddy web api >/dev/null 2>&1 || true
  step "Datenbank neu anlegen und einspielen"
  # Frisches Volume, damit das Datenbankpasswort zur (ggf. übernommenen) .env passt
  compose rm -sf db >/dev/null
  docker volume rm -f "${COMPOSE_PROJECT}_pgdata" >/dev/null
  compose up -d db redis
  local i
  for i in $(seq 1 60); do
    compose exec -T db pg_isready -U wiki -d wiki >/dev/null 2>&1 && break
    sleep 2
  done
  compose exec -T db psql -q -v ON_ERROR_STOP=1 -U wiki -d wiki <"$tmp/staging/wiki.sql" >/dev/null
  ok "Datenbank eingespielt."

  step "Anhänge und Zertifikate zurückspielen"
  compose create api caddy >/dev/null 2>&1 || true
  local vol
  vol=$(volume_path attachments)
  find "$vol" -mindepth 1 -delete
  cp -a "$tmp/attachments/." "$vol/"
  if [[ -n $(ls -A "$tmp/caddy_data" 2>/dev/null) ]]; then
    vol=$(volume_path caddy_data)
    find "$vol" -mindepth 1 -delete
    cp -a "$tmp/caddy_data/." "$vol/"
  fi
  ok "Dateien zurückgespielt."

  step "Starten"
  # Sitzungen und Sperren gehören zum alten Stand
  # shellcheck disable=SC2016 # $REDIS_PASSWORD wird im Container aufgelöst
  compose exec -T redis sh -c 'REDISCLI_AUTH="$REDIS_PASSWORD" redis-cli FLUSHALL' >/dev/null || true
  compose up -d
  wait_healthy 300 || die "Die API ist nach der Wiederherstellung nicht gesund; Logs: wikictl logs api"
}

cmd_restore() {
  need_root
  need_env
  local id='' with_env=0 yes=0
  while (($#)); do
    case $1 in
      --with-env) with_env=1 ;;
      --yes) yes=1 ;;
      -*) die "Unbekannte Option $1" ;;
      *) id=$1 ;;
    esac
    shift
  done
  [[ -n $id ]] || die "Welcher Stand? wikictl restore latest oder eine ID aus wikictl snapshots"
  restic_env || die "Kein Sicherungsziel eingerichtet."
  warn "Die aktuelle Datenbank und alle Anhänge werden durch den Stand $id ersetzt."
  if ((!yes)); then
    local answer
    read -r -p "Zum Fortfahren WIEDERHERSTELLEN eingeben: " answer
    [[ $answer == WIEDERHERSTELLEN ]] || die "Abgebrochen."
  fi
  RESTORE_TMP=$(mktemp -d /var/tmp/wiki-restore.XXXXXX)
  trap 'rm -rf "$RESTORE_TMP"' EXIT
  local tmp=$RESTORE_TMP
  step "Stand $id holen"
  restore_to_dir "$id" "$tmp"

  if ((with_env)); then
    cp -p "$ENV_FILE" "$ENV_FILE.vor-restore"
    install -m 600 "$tmp/staging/env" "$ENV_FILE"
    ok ".env aus der Sicherung übernommen (bisherige in .env.vor-restore)."
  elif [[ $(env_get ENCRYPTION_KEY "$tmp/staging/env") != "$(env_get ENCRYPTION_KEY)" ]]; then
    warn "ENCRYPTION_KEY in der Sicherung unterscheidet sich von der aktuellen .env: Zwei-Faktor-Anmeldung und"
    warn "SMTP-Passwort aus der Administration funktionieren dann nicht. Auf einem neuen Server --with-env verwenden."
  fi

  # Vor dem Zurückspielen den aktuellen Stand sichern (sofern es ihn gibt)
  if compose ps -q db 2>/dev/null | grep -q . && ((!with_env)); then
    step "Aktuellen Stand vorher sichern"
    backup_run vor-wiederherstellung || warn "Sicherung des aktuellen Stands fehlgeschlagen; fahre trotzdem fort."
  fi

  restore_apply "$tmp"
  ok "Wiederherstellung abgeschlossen. Alle Benutzer müssen sich neu anmelden."
}

cmd_restore_test() {
  need_root
  need_env
  restic_env || die "Kein Sicherungsziel eingerichtet."
  local ping
  ping=$(env_get BACKUP_PING_URL)
  if restore_test_run; then
    return 0
  fi
  if [[ -n $ping ]]; then ping_url "$ping/fail"; fi
  die "Test-Wiederherstellung fehlgeschlagen."
}

# Zählerstände für Prüfungen und Manifest (eine Zeile, gleiche Form in restore-test, export und import)
COUNTS_SQL="SELECT (SELECT count(*) FROM users) || ' Benutzer, ' || (SELECT count(*) FROM spaces) || ' Spaces, ' || (SELECT count(*) FROM pages) || ' Seiten, ' || (SELECT count(*) FROM attachments) || ' Anhänge'"
# Alle Dateien im Anhang-Verzeichnis mit Prüfsumme: aktuelle Anhänge und ältere Fassungen
ATTACHMENT_FILES_SQL="SELECT storage_key, sha256 FROM attachments UNION SELECT storage_key, sha256 FROM attachment_versions"

# Jeder Anhang muss mit der Prüfsumme aus der Datenbank vorhanden sein (Ablage: <erste 2 Zeichen>/<schlüssel>).
# attachment_check <verzeichnis>, Zeilen "schlüssel|sha256" auf stdin; bricht bei fehlenden oder beschädigten Dateien ab.
attachment_check() {
  local dir=$1 broken=0 key sum file
  while IFS='|' read -r key sum; do
    [[ -z $key ]] && continue
    # Schlüssel wie in der API (attachment-storage.service.ts) und keine Verknüpfungen: root liest nur im Verzeichnis
    if [[ ! $key =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]]; then
      broken=$((broken + 1))
      warn "Ungültiger Ablageschlüssel in der Datenbank: $(printf '%q' "$key")"
      continue
    fi
    file=$dir/${key:0:2}/$key
    if [[ -L $file || ! -f $file ]]; then
      broken=$((broken + 1))
      warn "Anhang fehlt: $key"
    elif [[ $(sha256sum "$file" | cut -d' ' -f1) != "$sum" ]]; then
      broken=$((broken + 1))
      warn "Anhang beschädigt (Prüfsumme): $key"
    fi
  done
  ((broken == 0)) || die "$broken Anhänge fehlen oder sind beschädigt."
}

# Dasselbe Postgres-Image wie der Dienst db, damit der Test nicht ein zweites, ungepflegtes Image zieht
db_image() {
  compose config --images db
}

restore_test_run() {
  (
    set -Eeuo pipefail
    local tmp name
    tmp=$(mktemp -d /var/tmp/wiki-restore-test.XXXXXX)
    name=wikifordummys-restore-test-$$
    trap 'docker rm -f "$name" >/dev/null 2>&1; rm -rf "$tmp"' EXIT
    step "Prüfe die Integrität des Sicherungsziels (Stichprobe)"
    restic check --read-data-subset=5% --quiet
    step "Letzten Stand in ein temporäres Verzeichnis holen"
    restore_to_dir latest "$tmp"
    step "Datenbank in einen Wegwerf-Container einspielen"
    docker run -d --name "$name" --network none --tmpfs /var/lib/postgresql/data \
      -e POSTGRES_USER=wiki -e POSTGRES_DB=wiki -e POSTGRES_PASSWORD=test "$(db_image)" >/dev/null
    local i
    for i in $(seq 1 60); do
      docker exec "$name" pg_isready -U wiki -d wiki >/dev/null 2>&1 && break
      sleep 2
    done
    # pg_isready meldet schon während des Init-Laufs bereit; kurz auf den endgültigen Start warten
    sleep 3
    for i in $(seq 1 30); do
      docker exec "$name" psql -U wiki -d wiki -c 'SELECT 1' >/dev/null 2>&1 && break
      sleep 2
    done
    docker exec -i "$name" psql -q -v ON_ERROR_STOP=1 -U wiki -d wiki <"$tmp/staging/wiki.sql" >/dev/null
    local counts
    counts=$(docker exec "$name" psql -At -U wiki -d wiki -c "$COUNTS_SQL")
    info "Inhalt: $counts"
    attachment_check "$tmp/attachments" < <(docker exec "$name" psql -At -U wiki -d wiki -c "$ATTACHMENT_FILES_SQL")
    [[ -s $tmp/staging/env ]] || die ".env fehlt in der Sicherung."
    ok "Test-Wiederherstellung erfolgreich: $counts, alle Anhänge vollständig."
  )
}

# ---------------------------------------------------------------------------
# Umzug auf einen anderen Server: export packt alles in eine verschlüsselte Datei, import spielt sie auf einem
# frisch installierten Server ein (Ablauf in docs/umzug.md)

MIGRATE_FORMAT=1
# Aus der .env des alten Servers übernommen: Schlüssel, ohne die Daten unbrauchbar werden (ENCRYPTION_KEY: 2FA und
# SMTP-Passwort in der Datenbank), und Einstellungen des Wikis. Alles andere (Domain, Betriebsart, Ports, Proxy,
# Sicherung, Überwachung, Passwörter von Datenbank und Redis) hat der Installer auf dem neuen Server festgelegt.
MIGRATE_KEYS=(ENCRYPTION_KEY SESSION_SECRET SMTP_URL MAIL_FROM WIKI_OFFICE WIKI_DRAWIO OFFICE_VERSION ATTACHMENT_MAX_MB
  ATTACHMENT_MIN_FREE_MB ATTACHMENT_QUOTA_MB_PER_DAY RATE_UPLOADS_PER_HOUR OAUTH_REDIRECT_HOSTS)

# Passwort der Umzugsdatei: aus --passphrase-file <datei> (z. B. für Skripte; root gehört sie, nur für root lesbar),
# sonst beim Export erzeugt und nur im Terminal angezeigt, beim Import abgefragt
migrate_passphrase() {
  local mode=$1 file=${2:-}
  if [[ -n $file ]]; then
    [[ -f $file && ! -L $file ]] || die "Passwortdatei $file fehlt."
    [[ $(stat -c '%u' "$file") == 0 && $(($(stat -c '%#a' "$file") & 077)) == 0 ]] ||
      die "Die Passwortdatei muss root gehören und darf nur für root lesbar sein (chmod 600)."
    IFS= read -r MIGRATE_PASS <"$file" || true
    ((${#MIGRATE_PASS} >= 16)) || die "Das Passwort in $file ist zu kurz (mindestens 16 Zeichen)."
    return 0
  fi
  if [[ $mode == export ]]; then
    # Das erzeugte Passwort gehört nicht in umgeleitete Ausgaben oder Logs
    [[ -t 1 ]] || die "Ausgabe geht nicht ins Terminal; das Passwort mit --passphrase-file vorgeben."
    MIGRATE_PASS=$(openssl rand -base64 33 | tr -d '/+=\n')
    MIGRATE_PASS_NEW=1
    return 0
  fi
  [[ -t 0 ]] || die "Kein Terminal für die Passwortabfrage; das Passwort mit --passphrase-file übergeben."
  read -r -s -p "Passwort der Umzugsdatei: " MIGRATE_PASS
  echo
  [[ -n $MIGRATE_PASS ]] || die "Kein Passwort eingegeben."
}

# gpg mit dem Passwort über einen eigenen Dateideskriptor (nicht in der Prozessliste) und ohne Zwischenspeicher im gpg-agent
migrate_gpg() {
  gpg --batch --quiet --yes --no-tty --pinentry-mode loopback --no-symkey-cache --passphrase-fd 3 "$@" 3< <(printf '%s' "$MIGRATE_PASS")
}

# Klartext-Reste abgebrochener Läufe (z. B. nach Stromausfall) melden; sie enthalten Schlüssel und Datenbank
migrate_leftovers() {
  local d
  for d in /var/tmp/wiki-export.* /var/tmp/wiki-import.*; do
    [[ -d $d ]] && warn "Rest eines abgebrochenen Laufs mit Klartextdaten: $d (löschen mit sudo rm -rf $d)"
  done
  return 0
}

# Wert aus dem Manifest (Zeilen schlüssel=wert)
manifest_get() {
  local line
  line=$(grep -E "^$1=" "$2" | head -n 1) || true
  printf '%s' "${line#*=}"
}

# Prüfsummen aller Dateien unter <basis>, mit Pfaden ab dem Wurzelverzeichnis des Archivs (<präfix>/…)
checksum_tree() {
  local base=$1 prefix=$2
  (cd "$base" && find . -type f -print0 | sort -z | xargs -0 -r sha256sum) | sed "s|  \./|  $prefix/|"
}

cmd_export() {
  need_root
  need_env
  local out='' stop=0 passfile=''
  while (($#)); do
    case $1 in
      --output)
        [[ -n ${2:-} ]] || die "--output braucht einen Dateinamen."
        out=$2
        shift
        ;;
      --passphrase-file)
        [[ -n ${2:-} ]] || die "--passphrase-file braucht einen Dateinamen."
        passfile=$2
        shift
        ;;
      --stop) stop=1 ;;
      *) die "Unbekannte Option $1 (wikictl export [--output <datei>] [--passphrase-file <datei>] [--stop])" ;;
    esac
    shift
  done
  command -v gpg >/dev/null || die "gpg fehlt: sudo apt install gnupg"
  compose ps -q db 2>/dev/null | grep -q . || die "Die Datenbank läuft nicht. Zuerst starten: sudo wikictl start"
  if [[ -z $out ]]; then
    install -d -m 700 /var/backups/wikifordummys
    out=/var/backups/wikifordummys/umzug-$(hostname -s)-$(date +%F-%H%M).wiki.gpg
  fi
  [[ ! -e $out && ! -e $out.part ]] || die "$out oder $out.part gibt es schon."
  [[ -d $(dirname "$out") ]] || die "Verzeichnis $(dirname "$out") fehlt."

  local attachments caddy db_mb att_mb caddy_mb=0 free need
  attachments=$(volume_path attachments) || die "Volume ${COMPOSE_PROJECT}_attachments fehlt."
  caddy=$(volume_path caddy_data) || caddy=''
  att_mb=$(du -sm "$attachments" | cut -f1)
  if [[ -n $caddy ]]; then caddy_mb=$(du -sm "$caddy" | cut -f1); fi
  db_mb=$(compose exec -T db psql -At -U wiki -d wiki -c "SELECT pg_database_size('wiki') / 1048576" | tr -d '\r')
  # Ziel: Anhänge, Zertifikate und Datenbankexport; der Export liegt zusätzlich kurz in /var/tmp
  need=$((att_mb + caddy_mb + 2 * ${db_mb:-0} + 500))
  free=$(df -Pm "$(dirname "$out")" | awk 'NR == 2 {print $4}')
  ((free >= need)) || die "In $(dirname "$out") sind $free MB frei, die Umzugsdatei braucht etwa $need MB. Mit --output ein anderes Ziel angeben."
  migrate_passphrase export "$passfile"
  migrate_leftovers

  (
    set -Eeuo pipefail
    umask 077
    local tmp stopped=0
    tmp=$(mktemp -d /var/tmp/wiki-export.XXXXXX)
    # Bei Fehlern das Wiki wieder starten und nichts Halbfertiges liegen lassen
    trap 'rm -rf "$tmp" "$out.part"; if ((stopped)); then compose up -d >/dev/null 2>&1 || true; fi' EXIT
    install -d -m 700 "$tmp/staging"

    step "Schreibzugriffe anhalten (Weboberfläche, API und Caddy)"
    info "Das Wiki ist bis zum Ende des Exports nicht erreichbar."
    stopped=1
    compose stop caddy web api >/dev/null

    step "Datenbank exportieren"
    compose exec -T db pg_dump -U wiki --clean --if-exists --no-owner wiki >"$tmp/staging/wiki.sql"
    # Nur was der Import übernimmt; Zugänge zur Sicherung und Passwörter, die nur hier gelten, bleiben auf diesem Server
    local key value
    : >"$tmp/staging/env"
    for key in "${MIGRATE_KEYS[@]}"; do
      value=$(env_get "$key")
      if [[ -n $value ]]; then env_set "$key" "$value" "$tmp/staging/env"; fi
    done
    git -C "$WIKI_DIR" rev-parse HEAD >"$tmp/staging/version"
    local counts svc id
    counts=$(compose exec -T db psql -At -U wiki -d wiki -c "$COUNTS_SQL" | tr -d '\r')
    {
      echo "format=$MIGRATE_FORMAT"
      echo "created=$(date -Is)"
      echo "host=$(hostname)"
      echo "commit=$(cat "$tmp/staging/version")"
      echo "domain=$(env_get WIKI_DOMAIN)"
      echo "tls=$(env_get WIKI_TLS)"
      echo "office=$(env_get WIKI_OFFICE)"
      echo "drawio=$(env_get WIKI_DRAWIO)"
      echo "counts=$counts"
      # Images, mit denen der alte Server lief (Name und ID), zum Vergleich auf dem neuen Server
      for svc in $(compose config --services); do
        id=$(compose ps -aq "$svc" 2>/dev/null | head -n 1)
        [[ -n $id ]] || continue
        echo "image.$svc=$(docker inspect -f '{{.Config.Image}} {{.Image}}' "$id")"
      done
    } >"$tmp/staging/manifest"
    info "Inhalt: $counts"

    if [[ -n $(find "$attachments" -perm /6000 -print -quit) ]]; then
      warn "Im Anhang-Volume liegen Dateien mit setuid/setgid-Bit; der Import lehnt die Umzugsdatei ab. Prüfen: sudo find $attachments -perm /6000"
    fi
    step "Prüfsummen berechnen"
    {
      checksum_tree "$tmp/staging" staging
      checksum_tree "$attachments" attachments
      if [[ -n $caddy ]]; then checksum_tree "$caddy" caddy_data; fi
    } >"$tmp/checksums.sha256"
    mv "$tmp/checksums.sha256" "$tmp/staging/checksums.sha256"

    step "Packen und verschlüsseln nach $out"
    # Volumes unter festen Namen ins Archiv; Verknüpfungen werden nicht verfolgt
    local vroot names=("${COMPOSE_PROJECT}_attachments/_data")
    vroot=$(dirname "$(dirname "$attachments")")
    if [[ -n $caddy ]]; then
      [[ $(dirname "$(dirname "$caddy")") == "$vroot" ]] || die "Die Volumes liegen in verschiedenen Verzeichnissen; das unterstützt der Export nicht."
      names+=("${COMPOSE_PROJECT}_caddy_data/_data")
    fi
    tar --numeric-owner -cf - -C "$tmp" staging -C "$vroot" \
      --transform "s|^${COMPOSE_PROJECT}_attachments/_data|attachments|S" \
      --transform "s|^${COMPOSE_PROJECT}_caddy_data/_data|caddy_data|S" "${names[@]}" |
      migrate_gpg --symmetric --cipher-algo AES256 --s2k-digest-algo SHA512 --compress-algo none -o "$out.part"
    chmod 600 "$out.part"
    mv "$out.part" "$out"

    if ((stop)); then
      step "Alter Server bleibt angehalten"
      compose stop >/dev/null
      info "Alle Dienste sind angehalten, damit niemand mehr hier schreibt. Wieder starten mit: sudo wikictl start"
    else
      step "Wiki wieder starten"
      compose up -d >/dev/null
      wait_healthy 300 || warn "Die API ist noch nicht gesund; Logs: wikictl logs api"
    fi
    # shellcheck disable=SC2034 # liest der trap
    stopped=0
  ) || die "Export fehlgeschlagen."

  ok "Umzugsdatei: $out ($(du -h "$out" | cut -f1))"
  info "SHA-256: $(sha256sum "$out" | cut -d' ' -f1)  (nach dem Kopieren auf dem neuen Server mit sha256sum vergleichen)"
  if ((${MIGRATE_PASS_NEW:-0})); then
    step "Passwort der Umzugsdatei (wird nicht gespeichert, jetzt notieren)"
    info "  $MIGRATE_PASS"
  fi
  info "Die Datei enthält alle Schlüssel des Wikis. Getrennt vom Passwort übertragen und nach dem Umzug löschen."
  info "Weiter auf dem neuen Server: Installer ausführen, Datei kopieren, sudo wikictl import <datei> (docs/umzug.md)."
}

cmd_import() {
  need_root
  need_env
  local file='' yes=0 passfile=''
  while (($#)); do
    case $1 in
      --yes) yes=1 ;;
      --passphrase-file)
        [[ -n ${2:-} ]] || die "--passphrase-file braucht einen Dateinamen."
        passfile=$2
        shift
        ;;
      -*) die "Unbekannte Option $1 (wikictl import <datei> [--passphrase-file <datei>] [--yes])" ;;
      *) file=$1 ;;
    esac
    shift
  done
  [[ -n $file ]] || die "Welche Datei? sudo wikictl import <umzugsdatei>"
  [[ -f $file ]] || die "$file gibt es nicht."
  command -v gpg >/dev/null || die "gpg fehlt: sudo apt install gnupg"
  local size_mb free
  size_mb=$(du -m "$file" | cut -f1)
  # Ausgepackt in /var/tmp und danach noch einmal in den Volumes
  free=$(df -Pm /var/tmp | awk 'NR == 2 {print $4}')
  ((free >= size_mb + 1000)) || die "In /var/tmp sind $free MB frei, zum Auspacken nötig sind etwa $((size_mb + 1000)) MB."
  free=$(docker_free_mb)
  ((free >= size_mb + 2000)) || die "Für Docker sind $free MB frei, nötig sind etwa $((size_mb + 2000)) MB."
  migrate_passphrase import "$passfile"
  migrate_leftovers

  IMPORT_TMP=$(mktemp -d /var/tmp/wiki-import.XXXXXX)
  trap 'rm -rf "$IMPORT_TMP"' EXIT
  local tmp=$IMPORT_TMP/data status=$IMPORT_TMP/gpg-status
  install -d -m 700 "$tmp"
  step "Entschlüsseln und auspacken"
  # Ausgepackt wird nur ins temporäre Verzeichnis, verwendet erst nach den Prüfungen unten. gpg prüft die Integrität (MDC)
  # am Ende; der Klartext ist so groß wie die Datei (export packt nicht), mehr bricht ab.
  if ! migrate_gpg --status-fd 4 --max-output "$(((size_mb + 10) * 1048576))" --decrypt "$file" 4>"$status" |
    tar --numeric-owner --same-owner --no-overwrite-dir -xf - -C "$tmp"; then
    die "Entschlüsseln fehlgeschlagen: falsches Passwort oder beschädigte Datei."
  fi
  # Ohne Verschlüsselung (z. B. gpg --store) gäbe gpg den Inhalt mit jedem Passwort aus: nur symmetrisch verschlüsselte,
  # mit dem Passwort entschlüsselte und unveränderte Dateien annehmen
  if ! grep -q '^\[GNUPG:\] NEED_PASSPHRASE_SYM ' "$status" || ! grep -q '^\[GNUPG:\] DECRYPTION_OKAY' "$status" ||
    ! grep -q '^\[GNUPG:\] GOODMDC' "$status" || grep -q '^\[GNUPG:\] DECRYPTION_FAILED' "$status" ||
    (($(grep -c '^\[GNUPG:\] PLAINTEXT ' "$status") != 1)); then
    die "Die Datei ist nicht mit dem Passwort verschlüsselt oder nicht unverändert; das ist keine Umzugsdatei von wikictl export."
  fi
  local entry
  for entry in "$tmp"/*; do
    case ${entry##*/} in
      staging | attachments | caddy_data) ;;
      *) die "Unerwarteter Inhalt in der Umzugsdatei: ${entry##*/}" ;;
    esac
  done
  [[ -z $(find "$tmp" -mindepth 1 ! -type f ! -type d -print -quit) ]] || die "Die Umzugsdatei enthält Verknüpfungen oder Gerätedateien."
  [[ -z $(find "$tmp" -perm /6000 -print -quit) ]] || die "Die Umzugsdatei enthält Dateien mit setuid/setgid-Bit."
  local manifest=$tmp/staging/manifest
  [[ -f $manifest && -f $tmp/staging/wiki.sql && -f $tmp/staging/env ]] || die "Das ist keine Umzugsdatei von wikictl export."
  [[ $(manifest_get format "$manifest") == "$MIGRATE_FORMAT" ]] || die "Unbekanntes Format der Umzugsdatei ($(manifest_get format "$manifest"))."
  install -d "$tmp/attachments" "$tmp/caddy_data"

  step "Prüfsummen prüfen"
  (cd "$tmp" && sha256sum --check --quiet --strict staging/checksums.sha256) || die "Prüfsummen stimmen nicht; die Datei ist beschädigt."
  local listed present
  listed=$(wc -l <"$tmp/staging/checksums.sha256")
  present=$(cd "$tmp" && find staging attachments caddy_data -type f ! -path staging/checksums.sha256 | wc -l)
  ((listed == present)) || die "Die Umzugsdatei enthält Dateien ohne Prüfsumme."
  ok "Alle $listed Dateien unverändert."

  step "Versionen vergleichen"
  local commit here
  commit=$(manifest_get commit "$manifest")
  here=$(git -C "$WIKI_DIR" rev-parse HEAD)
  if [[ $commit != "$here" ]]; then
    die "Der alte Server lief mit Stand ${commit:0:12}, dieser mit ${here:0:12}. Zuerst angleichen: sudo wikictl update $commit, dann den Import wiederholen."
  fi
  ok "Gleicher Stand: ${here:0:12}."
  local line service ref cur
  while IFS= read -r line; do
    [[ $line == image.* ]] || continue
    service=${line%%=*} service=${service#image.}
    read -r ref _ <<<"${line#*=}"
    # Fremde Images stehen mit Digest in docker-compose.yml; eigene werden gebaut und haben daher eine andere ID
    [[ $ref == *@sha256:* ]] || continue
    cur=$(compose config --images "$service" 2>/dev/null || true)
    [[ -z $cur || $cur == "$ref" ]] || warn "Image für $service weicht ab: alt $ref, neu $cur"
  done <"$manifest"

  local old_domain new_domain old_tls new_tls current
  old_domain=$(manifest_get domain "$manifest")
  new_domain=$(env_get WIKI_DOMAIN)
  old_tls=$(manifest_get tls "$manifest")
  new_tls=$(env_get WIKI_TLS)
  current=$(compose exec -T db psql -At -U wiki -d wiki -c "$COUNTS_SQL" 2>/dev/null | tr -d '\r' || true)
  step "Umzug"
  info "  Von:      $(manifest_get host "$manifest") ($old_domain, ${old_tls:-letsencrypt}), exportiert $(manifest_get created "$manifest")"
  info "  Nach:     $(hostname) ($new_domain, ${new_tls:-letsencrypt})"
  info "  Inhalt:   $(manifest_get counts "$manifest")"
  warn "Datenbank und Anhänge dieses Servers werden ersetzt${current:+ (bisher: $current)}."
  if ((!yes)); then
    local answer
    read -r -p "Zum Fortfahren UMZIEHEN eingeben: " answer
    [[ $answer == UMZIEHEN ]] || die "Abgebrochen."
  fi

  step "Schlüssel und Einstellungen vom alten Server übernehmen"
  local key value
  [[ -n $(env_get ENCRYPTION_KEY "$tmp/staging/env") ]] || die "ENCRYPTION_KEY fehlt in der Umzugsdatei."
  cp -p "$ENV_FILE" "$ENV_FILE.vor-import"
  for key in "${MIGRATE_KEYS[@]}"; do
    value=$(env_get "$key" "$tmp/staging/env")
    if [[ -n $value ]]; then env_set "$key" "$value"; fi
  done
  ok "Übernommen: ${MIGRATE_KEYS[*]} (bisherige .env in .env.vor-import)."
  if [[ $old_domain != "$new_domain" || ${old_tls:-letsencrypt} != "${new_tls:-letsencrypt}" ]]; then
    # Zertifikate der alten Domain nützen hier nichts; die von Caddy auf diesem Server bleiben
    rm -rf "${tmp:?}/caddy_data"
    install -d "$tmp/caddy_data"
    info "Andere Domain oder Betriebsart: Zertifikate dieses Servers bleiben, die alten werden nicht übernommen."
  fi
  if [[ $(env_get WIKI_DRAWIO) == true ]]; then compose build drawio >/dev/null; fi

  restore_apply "$tmp"
  reload_caddy

  step "Ergebnis prüfen"
  local counts expected
  counts=$(compose exec -T db psql -At -U wiki -d wiki -c "$COUNTS_SQL" | tr -d '\r')
  expected=$(manifest_get counts "$manifest")
  [[ $counts == "$expected" ]] || die "Inhalt weicht ab: erwartet $expected, eingespielt $counts."
  # Gegen die geprüfte Kopie in $tmp (cp -a hat sie 1:1 ins Volume übernommen), nicht im Volume, das die API schon nutzt
  attachment_check "$tmp/attachments" < <(compose exec -T db psql -At -U wiki -d wiki -c "$ATTACHMENT_FILES_SQL" | tr -d '\r')
  ok "Inhalt wie auf dem alten Server: $counts, alle Anhänge vollständig."
  wait_drawio
  wait_office
  ok "Umzug abgeschlossen. Alle Benutzer müssen sich neu anmelden."
  info "Nächste Schritte (docs/umzug.md): sudo wikictl status, DNS umstellen, alten Server abschalten, Umzugsdatei löschen."
  if [[ $old_domain != "$new_domain" ]]; then
    warn "Neue Domain ($old_domain → $new_domain): Android-App und claude.ai-Connectors müssen neu verbunden werden;"
    warn "Links aus alten Mails (Einladungen, Passwort-Reset) und Lesezeichen zeigen auf die alte Adresse."
  fi
}

cmd_monitor() {
  need_env
  local url state
  url=$(env_get MONITOR_PING_URL)
  state=$(compose exec -T api node -e "fetch('http://127.0.0.1:3001/api/v1/health').then(r=>r.json()).then(b=>console.log(b.status+' '+JSON.stringify(b.checks)),()=>console.log('fehler'))" 2>/dev/null || echo fehler)
  # Volle Platte früh melden: unter 1 GB frei steht die Datenbank kurz vor dem Stillstand
  local free
  free=$(docker_free_mb)
  if [[ $state == ok* ]] && ((free < 1000)); then state="platte-voll (${free} MB frei; sudo wikictl cleanup)"; fi
  if [[ $state == ok* ]]; then
    if [[ $state == *knapp* ]]; then warn "Speicherplatz wird knapp: $state"; fi
    ping_url "$url"
    return 0
  fi
  warn "Wiki nicht gesund: $state"
  if [[ -n $url ]]; then ping_url "$url/fail"; fi
  return 1
}

cmd_ca_cert() {
  need_env
  [[ $(env_get WIKI_TLS) == internal ]] || warn "Die Betriebsart ist nicht internal; das Zertifikat wird von Let's Encrypt bzw. dem Proxy ausgestellt."
  compose exec -T caddy cat /data/caddy/pki/authorities/local/root.crt
}

main() {
  local cmd=${1:-help}
  if (($#)); then shift; fi
  case $cmd in
    status) cmd_status ;;
    logs) cmd_logs "$@" ;;
    start) need_env && compose up -d ;;
    stop) need_env && compose stop ;;
    restart) need_env && compose restart "$@" ;;
    update) cmd_update "$@" ;;
    update-apply) cmd_update_apply "$@" ;;
    office) cmd_office "$@" ;;
    drawio) cmd_drawio "$@" ;;
    cleanup) cmd_cleanup ;;
    reconfigure) exec "$WIKI_DIR/install.sh" "$@" ;;
    create-admin) need_env && compose exec -T api node dist/cli.js create-admin "$@" ;;
    reset-password) need_env && compose exec -T api node dist/cli.js reset-password "$@" ;;
    mail-test) need_env && compose exec -T api node dist/cli.js mail-test "$@" ;;
    office-check) need_env && compose exec -T api node dist/cli.js office-check ;;
    backup) cmd_backup ;;
    backup-init) cmd_backup_init ;;
    snapshots) cmd_snapshots ;;
    restore) cmd_restore "$@" ;;
    restore-test) cmd_restore_test ;;
    export) cmd_export "$@" ;;
    import) cmd_import "$@" ;;
    monitor) cmd_monitor ;;
    ca-cert) cmd_ca_cert ;;
    help | -h | --help) usage ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
}

main "$@"
