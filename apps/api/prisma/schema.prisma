// Datenmodell Meilenstein 1: Benutzer, Gruppen, Einladungen, 2FA, Audit-Log.
// Meilenstein 2: Spaces, Seitenbaum, Seitenversionen.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  invited
  active
  deactivated
}

enum GlobalPermissionType {
  admin
  create_space
}

model User {
  id            String     @id @default(uuid()) @db.Uuid
  email         String     @unique
  displayName   String     @map("display_name")
  passwordHash  String?    @map("password_hash")
  /// AES-256-GCM-verschlüsselt (S2)
  totpSecret    String?    @map("totp_secret")
  totpEnabled   Boolean    @default(false) @map("totp_enabled")
  /// Zuletzt verwendeter TOTP-Zeitschritt, damit ein Code nur einmal gilt (S2)
  totpLastStep  Int?       @map("totp_last_step")
  status        UserStatus @default(invited)
  failedLogins  Int        @default(0) @map("failed_logins")
  lockedUntil   DateTime?  @map("locked_until")
  lastLoginAt   DateTime?  @map("last_login_at")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  recoveryCodes  RecoveryCode[]
  invitations    Invitation[]    @relation("InvitationUser")
  invitesSent    Invitation[]    @relation("InvitationInviter")
  passwordResets PasswordReset[]
  groups         GroupMember[]
  auditEntries   AuditLog[]
  spacesCreated  Space[]         @relation("SpaceCreator")
  pagesCreated   Page[]          @relation("PageCreator")
  pagesUpdated   Page[]          @relation("PageUpdater")
  pagesDeleted   Page[]          @relation("PageDeleter")
  pageVersions   PageVersion[]

  @@map("users")
}

model RecoveryCode {
  id       String    @id @default(uuid()) @db.Uuid
  userId   String    @map("user_id") @db.Uuid
  codeHash String    @map("code_hash")
  usedAt   DateTime? @map("used_at")
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("recovery_codes")
}

model Invitation {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  email      String
  tokenHash  String    @unique @map("token_hash")
  invitedBy  String?   @map("invited_by") @db.Uuid
  expiresAt  DateTime  @map("expires_at")
  acceptedAt DateTime? @map("accepted_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User      @relation("InvitationUser", fields: [userId], references: [id], onDelete: Cascade)
  inviter    User?     @relation("InvitationInviter", fields: [invitedBy], references: [id], onDelete: SetNull)

  @@map("invitations")
}

model PasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_resets")
}

model Group {
  id          String             @id @default(uuid()) @db.Uuid
  name        String             @unique
  description String             @default("")
  /// Systemgruppen (alle-benutzer, administratoren) können nicht gelöscht werden
  system      Boolean            @default(false)
  createdAt   DateTime           @default(now()) @map("created_at")
  members     GroupMember[]
  permissions GlobalPermission[]

  @@map("groups")
}

model GroupMember {
  groupId String @map("group_id") @db.Uuid
  userId  String @map("user_id") @db.Uuid
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
  @@map("group_members")
}

model GlobalPermission {
  groupId    String               @map("group_id") @db.Uuid
  permission GlobalPermissionType
  group      Group                @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([groupId, permission])
  @@map("global_permissions")
}

/// Nur anhängen: UPDATE wird per Trigger verhindert (S12)
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  ip         String?
  details    Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([action])
  @@map("audit_log")
}

enum SpaceStatus {
  active
  archived
}

model Space {
  id          String      @id @default(uuid()) @db.Uuid
  /// Kurzschlüssel wie IT oder HR, Großbuchstaben und Ziffern
  key         String      @unique
  name        String
  description String      @default("")
  status      SpaceStatus @default(active)
  homePageId  String?     @unique @map("home_page_id") @db.Uuid
  createdById String?     @map("created_by") @db.Uuid
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  homePage    Page?       @relation("SpaceHome", fields: [homePageId], references: [id], onDelete: SetNull)
  createdBy   User?       @relation("SpaceCreator", fields: [createdById], references: [id], onDelete: Restrict)
  pages       Page[]      @relation("SpacePages")

  @@map("spaces")
}

/// Aktueller Stand einer Seite. Jede Speicherung legt zusätzlich eine unveränderliche PageVersion an.
model Page {
  id          String        @id @default(uuid()) @db.Uuid
  spaceId     String        @map("space_id") @db.Uuid
  parentId    String?       @map("parent_id") @db.Uuid
  /// Materialisierter Pfad aus allen Vorfahren und der Seite selbst: /<id>/<id>/
  path        String
  /// Reihenfolge unter Geschwistern, beginnend bei 0
  position    Int
  title       String
  /// TipTap-JSON, nur erlaubte Knoten (S6)
  content     Json
  /// Reiner Text für Vergleich und spätere Volltextsuche
  contentText String        @map("content_text")
  version     Int           @default(1)
  createdById String?       @map("created_by") @db.Uuid
  updatedById String?       @map("updated_by") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  /// Papierkorb: gesetzt für die gelöschte Seite und alle mitgelöschten Unterseiten
  deletedAt   DateTime?     @map("deleted_at")
  deletedById String?       @map("deleted_by") @db.Uuid
  space       Space         @relation("SpacePages", fields: [spaceId], references: [id], onDelete: Cascade)
  parent      Page?         @relation("PageTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    Page[]        @relation("PageTree")
  homeOf      Space?        @relation("SpaceHome")
  createdBy   User?         @relation("PageCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User?         @relation("PageUpdater", fields: [updatedById], references: [id], onDelete: Restrict)
  deletedBy   User?         @relation("PageDeleter", fields: [deletedById], references: [id], onDelete: Restrict)
  versions    PageVersion[]

  @@index([spaceId, parentId])
  @@index([spaceId, path])
  @@index([deletedAt])
  @@map("pages")
}

/// Unveränderlich: UPDATE wird per Trigger verhindert
model PageVersion {
  id           String   @id @default(uuid()) @db.Uuid
  pageId       String   @map("page_id") @db.Uuid
  version      Int
  title        String
  content      Json
  contentText  String   @map("content_text")
  authorId     String?  @map("author_id") @db.Uuid
  /// Gesetzt, wenn diese Version durch Wiederherstellen einer älteren entstanden ist
  restoredFrom Int?     @map("restored_from")
  createdAt    DateTime @default(now()) @map("created_at")
  page         Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  author       User?    @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@unique([pageId, version])
  @@map("page_versions")
}
