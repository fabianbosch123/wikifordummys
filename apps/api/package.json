{
  "name": "@wiki/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "dev": "prisma generate && tsc -p tsconfig.build.json && (tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch --env-file-if-exists=../../.env dist/main.js)",
    "start": "node dist/main.js",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "cli": "node --env-file-if-exists=../../.env dist/cli.js"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@prisma/client": "~6.19.0",
    "@resvg/resvg-js": "^2.6.2",
    "@wiki/shared": "workspace:*",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "diff": "^9.0.0",
    "fast-xml-parser": "^5.11.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.0",
    "markdown-it": "^14.3.3",
    "nodemailer": "^10.2.1",
    "otplib": "^12.0.1",
    "prisma": "~6.19.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.0",
    "@swc/core": "^1.13.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.18.0",
    "@types/qrcode": "^1.5.5",
    "@types/smtp-server": "^3.5.13",
    "@types/supertest": "^6.0.3",
    "smtp-server": "^3.21.1",
    "supertest": "^7.1.4",
    "typescript": "~5.9.3",
    "unplugin-swc": "^1.5.7",
    "vitest": "^3.2.4"
  }
}
