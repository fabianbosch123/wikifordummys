<?xml version="1.0" encoding="utf-8"?>
<!-- Nur HTTPS und nur Zertifikate, denen das System vertraut. Keine Ausnahmen für einzelne Domains. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
