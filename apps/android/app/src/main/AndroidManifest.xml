<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Sicherheit:
      - allowBackup aus; zusätzlich schließen die Regeln für Android 12+ (dataExtractionRules) und ältere Versionen
        (fullBackupContent) alle Daten von Cloud-Backup und Geräteübertragung aus. Später gespeicherte Tokens landen so
        nie in einem Backup.
      - Nur HTTPS: usesCleartextTraffic aus und eine Network Security Config ohne Ausnahmen.
    -->
    <application
        android:name=".WikiApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.WikiForDummys"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
