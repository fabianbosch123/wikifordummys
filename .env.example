# Vorlage für die Konfiguration. Kopieren nach .env und mit `chmod 600 .env` schützen.
# Geheimnisse erzeugen mit: openssl rand -hex 32

# ---------- Betrieb mit Docker Compose ----------
# Öffentliche Domain des Wikis; der DNS-Eintrag muss auf den Server zeigen
WIKI_DOMAIN=wiki.example.de
# Image-Version (Tag), z. B. 0.1.0
WIKI_VERSION=latest

DB_PASSWORD=bitte-mit-openssl-rand-hex-32-ersetzen
REDIS_PASSWORD=bitte-mit-openssl-rand-hex-32-ersetzen
# 32 Byte als 64 Hex-Zeichen; verschlüsselt die TOTP-Geheimnisse. Nicht verlieren, nicht ändern!
ENCRYPTION_KEY=bitte-mit-openssl-rand-hex-32-ersetzen
SESSION_SECRET=bitte-mit-openssl-rand-hex-32-ersetzen

# Mailversand für Einladungen und Passwort-Reset, z. B. smtps://benutzer:passwort@smtp.example.de:465
# Leer lassen: Einladungslinks werden in der Admin-Oberfläche angezeigt, Passwort-Reset ist dann nicht möglich.
SMTP_URL=
MAIL_FROM=wikifordummys <wiki@example.de>

# ---------- Nur lokale Entwicklung (pnpm dev) ----------
# NODE_ENV=development
# APP_ORIGIN=http://localhost:3000
# DATABASE_URL=postgresql://wiki:wiki@localhost:5432/wiki
# REDIS_URL=redis://localhost:6379/0
# COOKIE_SECURE=false
# TRUST_PROXY=1
# SMTP_URL=smtp://localhost:1025
