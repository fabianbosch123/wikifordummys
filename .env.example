# Vorlage für die Konfiguration. Am einfachsten erzeugt ./install.sh die Datei .env (fragt Domain, SMTP usw. ab).
# Von Hand: kopieren nach .env, mit `chmod 600 .env` schützen, Geheimnisse mit `openssl rand -hex 32` erzeugen.
# Werte mit Leerzeichen in einfache Anführungszeichen setzen.

# ---------- Betrieb mit Docker Compose ----------
# Öffentliche Domain des Wikis
WIKI_DOMAIN=wiki.example.de
# Betriebsart, bestimmt die Herkunft des TLS-Zertifikats (Dateien in deploy/caddy):
#   letsencrypt  öffentlich erreichbar (VPS oder eigener Server mit Portfreigabe 80/443), DNS zeigt auf den Server
#   internal     nur im eigenen Netz; Zertifikat von Caddys eigener Zertifizierungsstelle (wikictl ca-cert)
#   proxy        hinter einem vorhandenen Reverse Proxy, der TLS übernimmt; Caddy spricht nur HTTP
WIKI_TLS=letsencrypt
# Ports auf dem Server (Standard 80 und 443). Im Proxy-Betrieb z. B. 127.0.0.1:8080 und 127.0.0.1:8443
# WIKI_HTTP_PORT=80
# WIKI_HTTPS_PORT=443
# Nur Proxy-Betrieb: Adressen des vorhandenen Proxys (Standard: private Netze) und Anzahl der Proxys vor der API
# WIKI_TRUSTED_PROXIES=private_ranges
# WIKI_TRUST_PROXY_HOPS=2

DB_PASSWORD=bitte-mit-openssl-rand-hex-32-ersetzen
REDIS_PASSWORD=bitte-mit-openssl-rand-hex-32-ersetzen
# 32 Byte als 64 Hex-Zeichen; verschlüsselt die TOTP-Geheimnisse und das SMTP-Passwort aus der Administration.
# Nicht verlieren, nicht ändern!
ENCRYPTION_KEY=bitte-mit-openssl-rand-hex-32-ersetzen
SESSION_SECRET=bitte-mit-openssl-rand-hex-32-ersetzen

# Mailversand für Einladungen und Passwort-Reset. Sonderzeichen in Benutzer und Passwort URL-kodieren (@ = %40).
#   smtps://benutzer:passwort@smtp.example.de:465   SSL/TLS
#   smtp://benutzer:passwort@smtp.example.de:587    STARTTLS (Pflicht)
#   smtp://mail.intern:25?tls=off                   unverschlüsselt, nur im internen Netz
# Leer lassen: Einladungslinks werden in der Administration angezeigt, Passwort-Reset ist dann nicht möglich.
# Unter Administration → E-Mail lässt sich der Zugang auch später ändern; das hat dann Vorrang vor diesem Wert.
SMTP_URL=
MAIL_FROM='wikifordummys <wiki@example.de>'

# Höchstgröße eines Anhangs in MiB (Standard 50), gilt für Caddy und API
# ATTACHMENT_MAX_MB=50

# IPv6 im Docker-Netz, damit die API echte IPv6-Adressen sieht (Rate-Limits, fail2ban). Setzt install.sh bzw.
# wikictl update selbst: true, wenn der Server IPv6 hat und Docker ab Version 27 läuft. Zum neu Prüfen die Zeile löschen.
# WIKI_IPV6=false

# Schutz vor voller Platte und Missbrauch von Anhängen (Werte in MiB):
# Uploads ablehnen, wenn danach weniger frei wäre (Standard 2048), Upload-Menge je Benutzer in 24 Stunden (Standard 2048)
# und Uploads je Benutzer und Stunde (Standard 300)
# ATTACHMENT_MIN_FREE_MB=2048
# ATTACHMENT_QUOTA_MB_PER_DAY=2048
# RATE_UPLOADS_PER_HOUR=300

# ---------- Office-Editor (optional) ----------
# Euro-Office zum Ansehen und Bearbeiten von Word-, Excel- und PowerPoint-Anhängen unter https://WIKI_DOMAIN/office/.
# true startet den zusätzlichen Dienst office (etwa 4 GB Arbeitsspeicher; Server mit 8 GB empfohlen).
WIKI_OFFICE=false
# Gemeinsames Geheimnis von API und Editor-Server für die signierten Nachrichten (JWT)
OFFICE_JWT_SECRET=bitte-mit-openssl-rand-hex-32-ersetzen
# Version des Images ghcr.io/euro-office/documentserver (Standard siehe docker-compose.yml)
# OFFICE_VERSION=v9.3.6

# ---------- Zeichnungen mit draw.io (optional) ----------
# draw.io (diagrams.net) unter https://WIKI_DOMAIN/draw/, um auf Seiten Zeichnungen wie Netzwerkpläne anzulegen.
# true startet den kleinen Dienst drawio (nur statische Dateien, etwa 150 MB Platz, kaum Arbeitsspeicher).
WIKI_DRAWIO=true

# ---------- Sicherung mit restic (wikictl backup, systemd-Timer) ----------
# Ziel, z. B. /mnt/backup/wiki, sftp:backup@nas.example.de:/wiki, s3:https://s3.example.com/bucket/wiki, rest:https://…
# BACKUP_REPOSITORY=
# Passwort des Backup-Repositorys; zusätzlich getrennt vom Server aufbewahren, sonst ist das Backup wertlos
# BACKUP_PASSWORD=
# Nur für S3: Zugangsschlüssel
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=

# ---------- Überwachung (optional) ----------
# Push-Adresse (z. B. Uptime Kuma "Push" oder healthchecks.io); wird alle 5 Minuten aufgerufen, solange das Wiki gesund ist
# MONITOR_PING_URL=
# Push-Adresse für Sicherungen; wird nach jeder erfolgreichen Sicherung aufgerufen, bei Fehlern mit /fail
# BACKUP_PING_URL=

# ---------- Nur lokale Entwicklung (pnpm dev) ----------
# NODE_ENV=development
# APP_ORIGIN=http://localhost:3000
# DATABASE_URL=postgresql://wiki:wiki@localhost:5432/wiki
# REDIS_URL=redis://localhost:6379/0
# COOKIE_SECURE=false
# TRUST_PROXY=1
# SMTP_URL=smtp://localhost:1025?tls=off
# ATTACHMENTS_DIR=./data/attachments
